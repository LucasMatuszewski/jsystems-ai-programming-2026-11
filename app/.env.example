# Copy to .env.local (git-ignored) or keep the real values in the repository-root .env.
# next.config.ts and scripts/load-env.ts load the root .env automatically.
OPENROUTER_API_KEY=sk-or-v1-replace-me
LLM_MODEL=openai/gpt-6-luna
DECISION_MODEL=typesafe/jev-1.14
FAST_PATH_ENABLED=true
FAST_PATH_THRESHOLD=0.8
LLM_REASONING_DECISION=high
LLM_REASONING_WRITER=low
LLM_REASONING_CHAT=medium
POLICIES_DIR=../docs/policies
DECISION_LOG_PATH=.data/decision-log.jsonl
APP_URL=http://localhost:3000
APP_TITLE=Hardware Service Decision Copilot
