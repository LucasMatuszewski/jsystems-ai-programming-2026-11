.next/
out/
coverage/
dist/
build/
*.db
.env*
!.env.example
secrets
.DS_Store
# Installed skills are restored from skills-lock.json (committed: the source of truth
# for which skills and versions the project uses). Skills authored in this repo are
# not in the lock, so they are committed explicitly below.
# .claude/skills/ holds the CLI's links to .agents/skills/.
.agents/skills/*
!.agents/skills/evidence-research/
.claude/skills/
# Repo-authored skills are always committed, even where an older rule ignores .agents/skills/*.
!.agents/skills/evidence-research/
!.agents/skills/write-plan/
# Agent briefs (.agent-briefs/) are committed during implementation and deleted with their plan;
# raw worker logs are not.
.agent-runs/
__pycache__/
*.pyc
.playwright-cli
playwright-report/
test-results/
playwright/.cache/

# Local Codex history, credentials and runtime state; keep shared config and rules.
.codex/auth.json
.codex/sessions/
.codex/archived_sessions/
.codex/history.jsonl
.codex/session_index.jsonl
.codex/log/
.codex/logs/
.codex/tmp/
.codex/*.sqlite*

# Java build artifacts
**/target/
*.class
/.idea
