{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "deny",
      "pnpm test*": "allow",
      "pnpm typecheck*": "allow",
      "pnpm lint*": "allow",
      "corepack pnpm test*": "allow",
      "corepack pnpm typecheck*": "allow",
      "corepack pnpm lint*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "ls*": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "pnpm add*": "deny",
      "pnpm install*": "deny"
    },
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "task": "deny"
  }
}
